{
  // Desarrollo dentro del contenedor `ingesta` con VS Code (extensión Dev Containers).
  // Levanta MongoDB y el servicio de embeddings; el código se edita en el host y se ve en /app.
  "name": "ingesta",
  "dockerComposeFile": ["../compose.yaml"],
  "service": "ingesta",
  "runServices": ["mongo", "embeddings", "ingesta"],
  "workspaceFolder": "/app",
  "overrideCommand": true,
  "remoteUser": "app",
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "charliermarsh.ruff"],
      "settings": {
        "python.defaultInterpreterPath": "/opt/venv/bin/python",
        "python.testing.pytestEnabled": true,
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff",
          "editor.formatOnSave": true
        }
      }
    }
  }
}
