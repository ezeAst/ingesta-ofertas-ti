# Copia este archivo como `.env` y reemplaza las claves. `.env` nunca se versiona.
# Las claves deben ser alfanuméricas: se insertan en la URI de conexión de MongoDB sin escapar.

# --- MongoDB (solo escucha en 127.0.0.1) ---
MONGO_ROOT_USUARIO=raiz
MONGO_ROOT_CLAVE=cambiar
MONGO_BD=ingesta
MONGO_APP_USUARIO=ingesta
MONGO_APP_CLAVE=cambiar

# --- Servicio de embeddings (TEI) ---
# Revisión fijada del modelo en Hugging Face, para que los vectores sean reproducibles.
EMBEDDINGS_MODELO=intfloat/multilingual-e5-large
EMBEDDINGS_REVISION=3d7cfbdacd47fdda877c5cd8a79fbcc4f2a574f3

# --- Qdrant (R 2.4, perfil `r24`) ---
QDRANT_API_KEY=cambiar
